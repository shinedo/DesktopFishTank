<Window x:Class="DesktopFishTank.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="机械鱼塘设置"
        Width="460"
        Height="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#0E141C"
        Foreground="#DCE7F2"
        FontFamily="Microsoft YaHei UI"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   Text="鱼群吸引快捷键"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="#EDF5FF" />
        <TextBlock x:Name="DescriptionText"
                   Grid.Row="1"
                   Text="按住该组合键时，所有鱼会转向鼠标位置并加速游过去。"
                   FontSize="12"
                   Foreground="#7E93AA"
                   TextWrapping="Wrap"
                   Margin="0,6,0,14" />

        <Border Grid.Row="2"
                Background="#141D28"
                BorderBrush="#24384D"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="BindingText"
                           FontSize="24"
                           FontFamily="Consolas"
                           Foreground="#43F0FF"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="CaptureHint"
                           FontSize="11"
                           Foreground="#6B7F95"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="ClearButton"
                    Content="清除"
                    Width="76"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="OnClearClick" />
            <Button x:Name="CaptureButton"
                    Content="重新绑定"
                    Width="96"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="OnCaptureClick" />
            <Button Content="完成"
                    Width="76"
                    Height="32"
                    IsDefault="True"
                    Click="OnDoneClick" />
        </StackPanel>
    </Grid>
</Window>
